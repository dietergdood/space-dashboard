{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?scope=rklb",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron?scope=asts",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron?scope=spcx",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron?scope=global",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron?scope=rklb_slow",
      "schedule": "0 11 * * 1,3,5"
    },
    {
      "path": "/api/cron?scope=asts_slow",
      "schedule": "0 11 * * 1,3,5"
    },
    {
      "path": "/api/cron?scope=spcx_slow",
      "schedule": "0 11 * * 1,3,5"
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/history.js": {
      "maxDuration": 30
    }
  }
}